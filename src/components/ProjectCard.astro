---
interface Props {
  project: {
    title: string;
    status: string;
    image: string;
    problem: string;
    solution: string;
    outcome: string;
    link: string;
    liveLink?: string;
    technologies: string[];
  };
  variant?: 'featured' | 'compact';
}

const { project, variant = 'compact' } = Astro.props;
const badge = 'px-2.5 py-1 text-xs font-medium rounded-md bg-neutral-900 text-neutral-400 border border-neutral-800';
const primaryHref = project.liveLink ?? project.link;
const primaryLabel = project.liveLink ? 'View live' : 'View code';
---

{
  variant === 'featured' ? (
    <article class="group flex flex-col md:flex-row bg-neutral-950 rounded-xl border border-neutral-800 overflow-hidden hover:border-neutral-700 transition duration-300">
      <div class="relative md:w-2/5 h-56 md:h-80 overflow-hidden bg-neutral-900 border-b md:border-b-0 md:border-r border-neutral-800">
        <div class="absolute top-0 left-0 w-28 h-28 overflow-hidden pointer-events-none z-20">
          <span class="absolute top-[18px] left-[-32px] w-[140px] -rotate-45 bg-brand-500 text-center text-[10px] font-bold uppercase tracking-wider text-white py-1">
            {project.status}
          </span>
        </div>
        <img
          src={project.image}
          alt={project.title}
          loading="lazy"
          class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-neutral-950/60 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition duration-300 flex items-center justify-center gap-4">
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center bg-neutral-900 border border-neutral-700 text-neutral-200 rounded-full hover:bg-neutral-800 hover:text-brand-200 transition duration-300"
            title="View Code"
            aria-label={`View the code for ${project.title}`}
          >
            <i class="fab fa-github text-sm"></i>
          </a>
        </div>
      </div>

      <div class="p-8 flex-grow flex flex-col justify-center">
        <p class="text-xs font-bold uppercase tracking-widest text-neutral-500 mb-2">
          Featured Case Study
        </p>
        <h3 class="font-display text-2xl font-bold text-neutral-100 mb-5">
          {project.title}
        </h3>

        <dl class="space-y-4 mb-6">
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-neutral-600 mb-1">
              The problem
            </dt>
            <dd class="text-sm text-neutral-400 leading-relaxed">{project.problem}</dd>
          </div>
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-brand-300/80 mb-1">
              What I built
            </dt>
            <dd class="text-sm text-neutral-300 leading-relaxed">{project.solution}</dd>
          </div>
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-neutral-600 mb-1">
              The outcome
            </dt>
            <dd class="text-sm text-neutral-400 leading-relaxed">{project.outcome}</dd>
          </div>
        </dl>

        <div class="flex flex-wrap gap-2 mb-6">
          {project.technologies.map((tech) => (
            <span class={badge}>{tech}</span>
          ))}
        </div>

        <a
          href={primaryHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-brand-200 transition duration-300 w-fit"
        >
          {primaryLabel} &rarr;
        </a>
      </div>
    </article>
  ) : (
    <article class="group flex flex-col bg-neutral-950 rounded-xl border border-neutral-800 overflow-hidden hover:border-neutral-700 transition duration-300">
      <div class="relative h-56 overflow-hidden bg-neutral-900 border-b border-neutral-800">
        <div class="absolute top-0 left-0 w-28 h-28 overflow-hidden pointer-events-none z-20">
          <span class="absolute top-[18px] left-[-32px] w-[140px] -rotate-45 bg-brand-500 text-center text-[10px] font-bold uppercase tracking-wider text-white py-1">
            {project.status}
          </span>
        </div>
        <img
          src={project.image}
          alt={project.title}
          loading="lazy"
          class="w-full h-full object-cover transition duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-neutral-950/60 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 transition duration-300 flex items-center justify-center gap-4">
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center bg-neutral-900 border border-neutral-700 text-neutral-200 rounded-full hover:bg-neutral-800 hover:text-brand-200 transition duration-300"
            title="View Code"
            aria-label={`View the code for ${project.title}`}
          >
            <i class="fab fa-github text-sm"></i>
          </a>
          {project.liveLink && (
            <a
              href={project.liveLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center bg-neutral-900 border border-neutral-700 text-neutral-200 rounded-full hover:bg-neutral-800 hover:text-brand-200 transition duration-300"
              title="View Live"
              aria-label={`View the live ${project.title} demo`}
            >
              <i class="fas fa-external-link-alt text-sm"></i>
            </a>
          )}
        </div>
      </div>

      <div class="p-6 flex-grow flex flex-col">
        <h3 class="font-display text-xl font-bold text-neutral-100 mb-4">
          {project.title}
        </h3>

        <dl class="space-y-3 mb-6 flex-grow">
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-neutral-600 mb-1">
              The problem
            </dt>
            <dd class="text-sm text-neutral-400 leading-relaxed">{project.problem}</dd>
          </div>
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-brand-300/80 mb-1">
              What I built
            </dt>
            <dd class="text-sm text-neutral-300 leading-relaxed">{project.solution}</dd>
          </div>
          <div>
            <dt class="text-[10px] font-bold uppercase tracking-wider text-neutral-600 mb-1">
              The outcome
            </dt>
            <dd class="text-sm text-neutral-400 leading-relaxed">{project.outcome}</dd>
          </div>
        </dl>

        <div class="flex flex-wrap gap-2 mb-4">
          {project.technologies.map((tech) => (
            <span class={badge}>{tech}</span>
          ))}
        </div>

        <a
          href={primaryHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-brand-200 transition duration-300 w-fit"
        >
          {primaryLabel} &rarr;
        </a>
      </div>
    </article>
  )
}
