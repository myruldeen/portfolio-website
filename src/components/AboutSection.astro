---
import { site, credentials, differentiators } from '../data/site.js';
---

<section id="about" class="py-24 bg-neutral-950 transition-colors duration-200">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <div class="mb-16">
      <p class="text-xs font-bold uppercase tracking-widest text-brand-300 mb-3">About</p>
      <h2 class="font-display text-3xl font-bold tracking-tight text-neutral-100 mb-4">
        A small studio, on purpose
      </h2>
      <p class="text-lg text-neutral-400 max-w-2xl">
        {site.name} is a solo practice run by {site.owner}. Working directly with the
        person doing the work keeps communication simple, quality consistent and
        costs lower than an agency would charge you for the same thing.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {credentials.map((item) => (
        <div class="rounded-xl border border-neutral-800 bg-neutral-900/40 p-6">
          <i class={`${item.icon} text-brand-300 text-sm mb-4`} aria-hidden="true"></i>
          <p class="font-display text-2xl font-bold text-neutral-100 mb-2">
            {item.value}
          </p>
          <p class="text-sm text-neutral-400 leading-relaxed">{item.label}</p>
        </div>
      ))}
    </div>

    <h3 class="font-display text-xl font-bold tracking-tight text-neutral-100 mb-8">
      How working with me is different
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
      {differentiators.map((item) => (
        <div>
          <h4 class="text-base font-semibold text-neutral-100 mb-2 flex items-start gap-3">
            <i class="fas fa-check text-brand-300 text-xs mt-1.5 shrink-0" aria-hidden="true"></i>
            {item.title}
          </h4>
          <p class="text-sm text-neutral-400 leading-relaxed pl-6">
            {item.description}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-14 p-6 sm:p-8 rounded-xl border border-neutral-800 bg-neutral-900/40 flex flex-col sm:flex-row sm:items-center gap-6">
      <div class="flex-1">
        <p class="text-sm text-neutral-300 leading-relaxed">
          Outside of building software I work as a {site.role.toLowerCase()}, which means
          I spend my days on production systems, user-reported bugs and the unglamorous
          work that keeps software running. It is a good background for building things
          that hold up outside a demo.
        </p>
      </div>
      <a
        href={site.socials.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium border border-neutral-700 rounded-xl text-neutral-200 hover:bg-neutral-800 transition duration-300"
      >
        <i class="fas fa-file-pdf" aria-hidden="true"></i>
        Read my full CV
      </a>
    </div>
  </div>
</section>
