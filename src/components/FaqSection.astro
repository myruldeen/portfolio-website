---
import { faqs } from '../data/site.js';
---

<section id="faq" class="py-24 bg-neutral-950 transition-colors duration-200">
  <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4">
        <p class="text-xs font-bold uppercase tracking-widest text-brand-300 mb-3">FAQ</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-neutral-100 mb-4">
          Questions I get asked a lot
        </h2>
        <p class="text-base text-neutral-400 leading-relaxed mb-6">
          The things clients usually want to know before getting in touch.
        </p>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-brand-200 transition duration-300"
        >
          Something else &rarr;
        </a>
      </div>

      <div class="lg:col-span-8">
        <div class="divide-y divide-neutral-800 border-y border-neutral-800">
          {faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex items-start justify-between gap-6 cursor-pointer list-none text-base font-medium text-neutral-100 hover:text-brand-200 transition duration-300">
                {faq.question}
                <i class="fas fa-plus text-xs text-neutral-500 group-open:rotate-45 group-open:text-brand-300 transition-transform duration-300 mt-1.5 shrink-0" aria-hidden="true"></i>
              </summary>
              <p class="text-sm text-neutral-400 leading-relaxed mt-4 max-w-2xl">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
