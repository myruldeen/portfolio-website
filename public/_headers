# Content-hashed build assets are immutable, so cache them hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# A stale service worker means users never receive updates, because the
# browser keeps validating against the old registration. Never cache these.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

# HTML must revalidate so a new deploy is picked up immediately.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
